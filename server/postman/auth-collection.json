{
  "info": {
    "_postman_id": "a5d89af2-18be-49ae-a795-2fd1809a6eaa",
    "name": "Chat App Auth API - Newman Edge Cases",
    "description": "Sequential auth endpoint tests based on the supplied implementation. Run against a disposable test database. Note: the source does not reveal configured maxLoginAttempts, lockDurationMs, refresh cookie name, or error status constants; adjust the environment/cookie names and lockout requests to match your configuration. Cookie assertions assume refresh_token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Signup succeeds",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/signup",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "signup"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Newman Test User\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "const b=pm.response.json();",
              "pm.test(\"success envelope\",()=>{pm.expect(b.state).eql(\"success\");pm.expect(b.error).eql(null);pm.expect(b).to.have.property(\"data\");pm.expect(Date.parse(b.meta.timestamp)).not.be.NaN;});",
              "pm.test(\"signup message\",()=>pm.expect(b.data.message).eql(\"Signed up\"));"
            ]
          }
        }
      ],
      "response": []
    },
