{
  "info": {
    "_postman_id": "f76d2c4c-84f3-4b5a-9b3c-680b189ab641",
    "name": "Chat App User API - Newman Edge Cases",
    "description": "User search endpoint success and query-parameter edge cases. Set baseUrl to the server origin and run against a disposable test database.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Setup - Signup dedicated friend-search test user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/signup",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "signup"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Friend Search Newman User\",\n  \"email\": \"friend-search-newman@example.test\",\n  \"password\": \"FriendSearchTestPassword123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));",
              "const b=pm.response.json();",
              "pm.test(\"signup succeeds\",()=>{pm.expect(b.state).eql(\"success\");pm.expect(b.error).eql(null);pm.expect(b.data.message).eql(\"Signed up\");});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Setup - Login dedicated friend-search test user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "login"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"friend-search-newman@example.test\",\n  \"password\": \"FriendSearchTestPassword123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "const b=pm.response.json();",
              "pm.test(\"login succeeds and saves access token\",()=>{pm.expect(b.state).eql(\"success\");pm.expect(b.error).eql(null);pm.expect(b.data.accessToken).to.be.a(\"string\").and.not.empty;pm.collectionVariables.set(\"friendSearchAccessToken\",b.data.accessToken);});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Friend search rejects missing access token",
      "request": {
        "method": "GET",
        "auth": {
          "type": "noauth"
        },
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/users/friend/search?q=__no-such-user-match__",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "users", "friend", "search"],
          "query": [{ "key": "q", "value": "__no-such-user-match__" }]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\",()=>pm.response.to.have.status(401));",
              "const b=pm.response.json();",
              "pm.test(\"authentication error envelope\",()=>{pm.expect(b.state).eql(\"error\");pm.expect(b.data).eql(null);pm.expect(b.error.detail).eql(\"Missing access token\");pm.expect(Date.parse(b.meta.timestamp)).not.be.NaN;});"
            ]
          }
        }
      ],
      "response": []
    },
